<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <EntityComponents>

    <!--
      Registers the Ground Truth weather event with the Event Controller.

      TypeId must equal the component type name declared by [MyComponentType] in
      WeatherIntensityEvent.cs. SubtypeId must be EventControllerBlockComponent -
      that is the subtype every stock event uses and what the block looks for.

      UniqueSelectionId identifies the event in the dropdown and in saved blocks.
      Vanilla occupies 0-22; 1001 leaves Keen room to add more without colliding.
      It must never be changed once published - saved Event Controllers reference it.
    -->
    <EntityComponent xsi:type="MyObjectBuilder_GTEventWeatherIntensityDefinition">
      <Id>
        <TypeId>GTEventWeatherIntensity</TypeId>
        <SubtypeId>EventControllerBlockComponent</SubtypeId>
      </Id>
      <UniqueSelectionId>1001</UniqueSelectionId>
    </EntityComponent>


    <EntityComponent xsi:type="MyObjectBuilder_GTEventWeatherTypeDefinition">
      <Id>
        <TypeId>GTEventWeatherType</TypeId>
        <SubtypeId>EventControllerBlockComponent</SubtypeId>
      </Id>
      <UniqueSelectionId>1002</UniqueSelectionId>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_GTEventRadAccumulatingDefinition">
      <Id>
        <TypeId>GTEventRadAccumulating</TypeId>
        <SubtypeId>EventControllerBlockComponent</SubtypeId>
      </Id>
      <UniqueSelectionId>1003</UniqueSelectionId>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_GTEventShelterLostDefinition">
      <Id>
        <TypeId>GTEventShelterLost</TypeId>
        <SubtypeId>EventControllerBlockComponent</SubtypeId>
      </Id>
      <UniqueSelectionId>1004</UniqueSelectionId>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_GTEventSealBreachedDefinition">
      <Id>
        <TypeId>GTEventSealBreached</TypeId>
        <SubtypeId>EventControllerBlockComponent</SubtypeId>
      </Id>
      <UniqueSelectionId>1005</UniqueSelectionId>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_GTEventWeatherHazardDefinition">
      <Id>
        <TypeId>GTEventWeatherHazard</TypeId>
        <SubtypeId>EventControllerBlockComponent</SubtypeId>
      </Id>
      <UniqueSelectionId>1006</UniqueSelectionId>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_GTEventTimeToCriticalDefinition">
      <Id>
        <TypeId>GTEventTimeToCritical</TypeId>
        <SubtypeId>EventControllerBlockComponent</SubtypeId>
      </Id>
      <UniqueSelectionId>1007</UniqueSelectionId>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_GTEventSolarOutputDefinition">
      <Id>
        <TypeId>GTEventSolarOutput</TypeId>
        <SubtypeId>EventControllerBlockComponent</SubtypeId>
      </Id>
      <UniqueSelectionId>1008</UniqueSelectionId>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_GTEventOxygenDefinition">
      <Id>
        <TypeId>GTEventOxygen</TypeId>
        <SubtypeId>EventControllerBlockComponent</SubtypeId>
      </Id>
      <UniqueSelectionId>1009</UniqueSelectionId>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_GTEventBioCountDefinition">
      <Id>
        <TypeId>GTEventBioCount</TypeId>
        <SubtypeId>EventControllerBlockComponent</SubtypeId>
      </Id>
      <UniqueSelectionId>1010</UniqueSelectionId>
    </EntityComponent>

    <EntityComponent xsi:type="MyObjectBuilder_GTEventBioContactsDefinition">
      <Id>
        <TypeId>GTEventBioContacts</TypeId>
        <SubtypeId>EventControllerBlockComponent</SubtypeId>
      </Id>
      <UniqueSelectionId>1011</UniqueSelectionId>
    </EntityComponent>

  </EntityComponents>
</Definitions>
