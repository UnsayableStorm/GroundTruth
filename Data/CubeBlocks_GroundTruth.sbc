      <DamagedSound>ParticleElectrical</DamagedSound>
      <EmissiveColorPreset>Default</EmissiveColorPreset>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>15</PCU>
      <IsAirTight>false</IsAirTight>
    </Definition>

    <Definition xsi:type="MyObjectBuilder_UpgradeModuleDefinition">
      <Id>
        <TypeId>UpgradeModule</TypeId>
        <SubtypeId>GT_HabitatMonitor</SubtypeId>
      </Id>
      <DisplayName>Habitat Monitor</DisplayName>
      <Description>Monitors interior seal integrity and reports breaches. Threshold Dynamics, Survey and Assessment.</Description>
      <Icon>Textures\GUI\Icons\Cubes\Control Panel.dds</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <!--
        Control Panel rather than the antenna. This block has to live INSIDE a sealed
        room, and a 1x3x1 antenna would demand a three-block-tall interior to fit -
        the model would fight the block's own purpose. 1x1x1, wall-mounted, flush.

        IsStandAlone false and HasPhysics false are copied from vanilla ControlPanel:
        it is a wall fixture, not a free-standing structure.

        IsAirTight false is also copied deliberately. Vanilla ControlPanel sets it
        explicitly, unlike the inset blocks where the tag is omitted so airtightness
        derives from mount points - see the DockingConnectorCamera lesson.
      -->
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Large\ControlPanel.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="4" />
        <Component Subtype="Construction" Count="6" />
        <Component Subtype="Detector" Count="2" />
        <Component Subtype="Computer" Count="6" />
        <Component Subtype="Display" Count="2" />
      </Components>
      <CriticalComponent Subtype="Display" Index="0" />
      <MountPoints>
        <MountPoint Side="Back" ExclusionMask="3" PropertiesMask="3" StartY="0.4" StartX="0.44" EndY="0.6" EndX="0.55" />
      </MountPoints>
      <IsStandAlone>false</IsStandAlone>
      <HasPhysics>false</HasPhysics>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\ControlPanelConstruction_1.mwm" />
      </BuildProgressModels>
      <BlockPairName>GT_HabitatMonitor</BlockPairName>
      <MirroringZ>Y</MirroringZ>
      <MirroringY>Z</MirroringY>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>8</BuildTimeSeconds>
      <PCU>10</PCU>
      <IsAirTight>false</IsAirTight>
    </Definition>

    <Definition xsi:type="MyObjectBuilder_UpgradeModuleDefinition">
      <Id>
        <TypeId>UpgradeModule</TypeId>
        <SubtypeId>GT_HabitatMonitor_S</SubtypeId>
      </Id>
      <DisplayName>Habitat Monitor</DisplayName>
      <Description>Monitors interior seal integrity and reports breaches. Threshold Dynamics, Survey and Assessment.</Description>
      <Icon>Textures\GUI\Icons\Cubes\Control Panel.dds</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <!--
        Small-grid sibling of the Habitat Monitor. Geometry, mount point and the
        IsStandAlone / HasPhysics pair are taken from vanilla SmallControlPanel, which
        is what this model belongs to.

        IsAirTight false is copied deliberately, exactly as on the large one: vanilla
        ControlPanel states it explicitly, unlike the inset blocks where the tag is
        omitted so airtightness derives from mount points.
      -->
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Small\ControlPanel.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="1" />
        <Component Subtype="Construction" Count="2" />
        <Component Subtype="Detector" Count="1" />
        <Component Subtype="Computer" Count="2" />
        <Component Subtype="Display" Count="1" />
      </Components>
      <CriticalComponent Subtype="Display" Index="0" />
      <MountPoints>
        <MountPoint Side="Back" ExclusionMask="3" PropertiesMask="3" StartX="0.4" StartY="0.44" EndX="0.6" EndY="0.55" />
      </MountPoints>
      <IsStandAlone>false</IsStandAlone>
      <HasPhysics>false</HasPhysics>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\small\ControlPanelConstruction_1.mwm" />
      </BuildProgressModels>
      <BlockPairName>GT_HabitatMonitor</BlockPairName>
      <MirroringZ>Y</MirroringZ>
      <MirroringY>Z</MirroringY>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>5</BuildTimeSeconds>
      <PCU>8</PCU>
      <IsAirTight>false</IsAirTight>
    </Definition>

    <!--
      General purpose antenna. NOT an instrument - vanilla RadioAntenna behaviour, no
      Ground Truth code attached, excluded from IsOurs() and from the API's role and
      capability tables. It ships because a general purpose antenna belongs in a sensor
      array collection, and because the pack it came from is being retired from the
      author's modlist.

      Definition adapted from MTGraves' Naval Theme Prop Pack (2494017078), used with
      permission. Broadcast behaviour is his; only the Id, name and pair name changed.
    -->
    <Definition xsi:type="MyObjectBuilder_RadioAntennaDefinition">
      <Id>
        <TypeId>RadioAntenna</TypeId>
        <SubtypeId>GT_RotatingRadarDish</SubtypeId>
      </Id>
      <DisplayName>Rotating Antenna</DisplayName>
      <Description>Long range radio antenna. Threshold Dynamics, Survey and Assessment.</Description>
      <Icon>Textures\Icons\Rotating_Radar_Dish_Icon.dds</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <Center x="0" y="0" z="0" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Large\Rotating_Radar_Dish.mwm</Model>
      <Components>
        <Component Subtype="SmallTube" Count="25" />
        <Component Subtype="Construction" Count="10" />
        <Component Subtype="SteelPlate" Count="10" />
        <Component Subtype="Computer" Count="10" />
        <Component Subtype="SteelPlate" Count="10" />
        <Component Subtype="Motor" Count="1" />
        <Component Subtype="RadioCommunication" Count="10" />
        <Component Subtype="SteelPlate" Count="10" />
      </Components>
      <CriticalComponent Subtype="RadioCommunication" Index="0" />
      <MountPoints>
        <MountPoint Side="Bottom" ExclusionMask="1" PropertiesMask="2" StartX="0" StartY="0" EndX="1" EndY="1" />
      </MountPoints>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.30" File="Models\Cubes\Large\Rotating_Radar_Dish_BS1.mwm" />
        <Model BuildPercentUpperBound="0.70" File="Models\Cubes\Large\Rotating_Radar_Dish_BS2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\Rotating_Radar_Dish_BS3.mwm" />
      </BuildProgressModels>
      <BlockPairName>GT_RotatingRadarDish</BlockPairName>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>22</BuildTimeSeconds>
      <MaxBroadcastRadius>50000</MaxBroadcastRadius>
      <DamageEffectName>Damage_Electrical_Damaged_Antenna</DamageEffectName>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>25</PCU>
      <IsAirTight>false</IsAirTight>
    </Definition>

    <Definition xsi:type="MyObjectBuilder_RadioAntennaDefinition">
      <Id>
        <TypeId>RadioAntenna</TypeId>
