        <Component Subtype="SteelPlate" Count="8" />
        <Component Subtype="Construction" Count="6" />
        <Component Subtype="SmallTube" Count="6" />
        <Component Subtype="Detector" Count="6" />
        <Component Subtype="Computer" Count="8" />
        <Component Subtype="SteelPlate" Count="4" />
      </Components>
      <CriticalComponent Subtype="Detector" Index="0" />
      <MountPoints>

      </MountPoints>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.30" File="Models\Cubes\Small\SG_1x1x1_Small_Radar_Dome_BS1.mwm" />
        <Model BuildPercentUpperBound="0.70" File="Models\Cubes\Small\SG_1x1x1_Small_Radar_Dome_BS2.mwm" />
        <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Small\SG_1x1x1_Small_Radar_Dome_BS3.mwm" />
      </BuildProgressModels>
      <BlockPairName>GT_BioScanner</BlockPairName>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <EdgeType>Light</EdgeType>
      <BuildTimeSeconds>10</BuildTimeSeconds>
